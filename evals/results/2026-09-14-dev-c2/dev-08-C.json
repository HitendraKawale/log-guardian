    "alternatives": [
      {
        "claim": "The timeout before connecting upstream could be caused by exhaustion of the HTTP client pool connections due to all connections being occupied by long_poll requests.",
        "evidence_ids": [
          "dev-08:01",
          "dev-08:02",
          "dev-08:03"
        ]
      }
    ],
    "likely_cause": {
      "claim": "The notification worker times out before connecting to its upstream because the HTTP client pool is fully occupied by long_poll requests, leaving no idle connections available for new publish requests, causing a PoolTimeout without any upstream connection attempt.",
      "evidence_ids": [
        "dev-08:01",
        "dev-08:02",
        "dev-08:03"
      ]
    },
    "outcome": "supported",
    "suggested_checks": [
      "Check the configuration and usage of the HTTP client pool in the notifier service to verify connection limits and sharing between long_poll and publish operations.",
      "Investigate the duration and concurrency of long_poll requests to understand their impact on connection pool availability.",
      "Review upstream service logs and metrics to confirm if connection attempts are being blocked or delayed due to client-side pool exhaustion."
    ]
